# PostgreSQL
POSTGRES_DB=crispr
POSTGRES_USER=crispr_app
POSTGRES_PASSWORD=

# Vercel uses a Neon pooled PostgreSQL URL.
DATABASE_URL=

# Authentication (password with 12 character)
AUTH_SECRET=
SECURITY_ADMIN_EMAIL=security-admin@example.com
SECURITY_ADMIN_PASSWORD=

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
API_DOCS_ENABLED=false

# AI Risk Advisor.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=

# Frontend. Keep VITE_API_URL empty for same-origin /api requests on Vercel.
VITE_API_MODE=live
VITE_API_URL=
