# Copy to .env and replace every placeholder before deployment.
AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
SECURITY_ADMIN_EMAIL=security@example.com
SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-password

# OpenAI-compatible LLM service used by the AI Risk Advisor.
LLM_ENABLED=true
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=replace-with-your-api-key
