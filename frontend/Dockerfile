FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG VITE_API_URL=
ARG VITE_API_MODE=live
ARG VITE_SIH_WORKSPACE=false
ARG VITE_SIH_DEMO_EMAIL=
ARG VITE_SIH_DEMO_PASSWORD=
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_API_MODE=${VITE_API_MODE}
ENV VITE_SIH_WORKSPACE=${VITE_SIH_WORKSPACE}
ENV VITE_SIH_DEMO_EMAIL=${VITE_SIH_DEMO_EMAIL}
ENV VITE_SIH_DEMO_PASSWORD=${VITE_SIH_DEMO_PASSWORD}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
